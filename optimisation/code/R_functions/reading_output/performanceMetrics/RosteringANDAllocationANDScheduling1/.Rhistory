metadata <- read.xlsx(paste("output_metadata/",methodID,".xlsx",sep=''),sheetIndex=1)
#load solution objects
solution <- readSolution(path,analysisID,metadata)
#manual fixes to save computational time
if(analysisID %in% c("RedbDistrAsIs","RedbDistrPopul")){ #due to districting not based on demand
solution$activity_types <- readRDS("../data/RedbDistrDem/model_output/solution_RedbDistrDem.rds")$activity_types
solution$activity_times <- readRDS("../data/RedbDistrDem/model_output/solution_RedbDistrDem.rds")$activity_times
solution$basic_unit_annual_demand <- readRDS("../data/RedbDistrDem/model_output/solution_RedbDistrDem.rds")$basic_unit_annual_demand
}
}
#sum(apply(solution$x_staff_to_visit_to_subperiod,2,sum)==0)
#save all model parameters and solution as an R object
saveRDS(solution,file=paste(path,'/',analysisID,"/model_output/solution_",analysisID,".rds",sep=''))
#staff groups for HHC plan - to be set to NA if output not to be split
typeIDs <- NA
#typeIDs <- c("CH","SC")
#compute performance
performance <- computePerformance(methodID,solution,typeIDs)
write.xlsx(performance,file=paste(path,'/',analysisID,"/model_output/performance_summary_",analysisID,".xlsx",sep=''),col.names=FALSE)
rm(list=ls())
