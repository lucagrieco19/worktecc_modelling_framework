library(xlsx)
activity_to_role <- read.xlsx("activity_to_role.xlsx",sheetIndex=1)
activity_to_role$activity <- gsub(' ','.',activity_to_role$activity)
rownames(activity_to_role) <- activity_to_role$activity
activity_times <- read.xlsx("activity_times.xlsx",sheetIndex=1)
activity_times$activity <- gsub(' ','.',sapply(activity_times$activity,function(s){strsplit(s,split="__")[[1]][2]}))
rownames(activity_times) <- activity_times$activity
activity_times <- activity_times[rownames(activity_to_role),]
activity_features <- data.frame(
type = activity_to_role$type,
service_time = activity_times$service_time
)
rownames(activity_features) <- rownames(activity_times)
activity_to_role <- activity_to_role[,-c(1,2)]
saveRDS(activity_features,file="activity_features.rds")
saveRDS(activity_to_role[,-7],file="activity_to_role.rds")
saveRDS(activity_to_role,file="alternative_activity_to_role.rds")
state_freq <- readRDS("original_state_freq.rds")
state_switch_freq <- readRDS("original_state_switch_freq.rds")
patient_need_states <- readRDS("original_patient_need_states.rds")
#select parameters to use in case studies
state_freq <- state_freq[1:8]
state_switch_freq <- state_switch_freq[1:8]
patient_need_states <- patient_need_states[1:8]
names(state_freq) <- paste("group",1:length(state_freq),sep='')
names(state_switch_freq) <- paste("group",1:length(state_switch_freq),sep='')
names(patient_need_states) <- paste("group",1:length(patient_need_states),sep='')
#change names of activities in parameter objects to eliminate the type of service (this will be mapped in other ways)
for(i in 1:length(patient_need_states)){
rownames(patient_need_states[[i]]) <- gsub(' ','.',sapply(rownames(patient_need_states[[i]]),function(s){strsplit(s,split="__")[[1]][2]}))
names(rownames(patient_need_states[[i]])) <- NULL
}
#low-skill activities (to be used for hybrid roles)
low_lev <- c("Bandaging","Bladder care","Blood.monitoring","Daily.living","Diabetic.care","Health.promotion","Hydration","Observations","Balance.therapy","Mobility.therapy")
for(i in 1:length(state_freq)){
ll <- intersect(rownames(patient_need_states[[i]]),low_lev)
hl <- setdiff(rownames(patient_need_states[[i]]),low_lev)
if(length(ll) > 0){
#select states that only have low-skill activities
ll_states <- colnames(patient_need_states[[i]])[which(apply(patient_need_states[[i]][ll,,drop=FALSE],2,max)>0 & apply(patient_need_states[[i]][hl,,drop=FALSE],2,max)==0)]
non_ll_states <- setdiff(colnames(patient_need_states[[i]]),ll_states)
if("Mobility.therapy" %in% rownames(patient_need_states[[i]])){
if("Daily.living" %in% rownames(patient_need_states[[i]])){
patient_need_states[[i]]["Mobility.therapy",ll_states] <- sample(patient_need_states[[i]]["Daily.living",ll_states],length(patient_need_states[[i]]["Mobility.therapy",ll_states]),replace=TRUE)
}
}
if("Balance.therapy" %in% rownames(patient_need_states[[i]])){
if("Mobility.therapy" %in% rownames(patient_need_states[[i]])){
patient_need_states[[i]]["Balance.therapy",ll_states] <- sample(patient_need_states[[i]]["Mobility.therapy",ll_states],length(patient_need_states[[i]]["Balance.therapy",ll_states]),replace=TRUE)
}
}
if("Blood.monitoring" %in% rownames(patient_need_states[[i]])){
if("Balance.therapy" %in% rownames(patient_need_states[[i]])){
patient_need_states[[i]]["Blood.monitoring",ll_states] <- sample(patient_need_states[[i]]["Balance.therapy",ll_states],length(patient_need_states[[i]]["Blood.monitoring",ll_states]),replace=TRUE)
}
}
if("Observations" %in% rownames(patient_need_states[[i]])){
if("Blood.monitoring" %in% rownames(patient_need_states[[i]])){
patient_need_states[[i]]["Observations",ll_states] <- sample(patient_need_states[[i]]["Blood.monitoring",ll_states],length(patient_need_states[[i]]["Observations",ll_states]),replace=TRUE)
}
}
#increase proportions of patients in states that only have low-skill activities
state_freq[[i]][ll_states] <- (state_freq[[i]][ll_states]+0.0001) * 0.2 / sum(state_freq[[i]][ll_states]+0.0001)
state_freq[[i]][non_ll_states] <- state_freq[[i]][non_ll_states] * 0.8 / sum(state_freq[[i]][non_ll_states])
}
}
#list all activities in the existing parameter objects and check whether the simplified list of activities is covered
ds_act <- unique(Reduce("c",lapply(patient_need_states,function(x){rownames(x)})))
length(intersect(ds_act,rownames(activity_to_role)))==length(unique(rownames(activity_to_role)))
setdiff(ds_act,rownames(activity_to_role))
#remove unused activities and states (note, it was checked that this doesn't affect the list of states)
for(i in 1:length(patient_need_states)){
patient_need_states[[i]] <- patient_need_states[[i]][rownames(patient_need_states[[i]]) %in% rownames(activity_to_role),]
patient_need_states[[i]] <- unique(patient_need_states[[i]],margin=2)
}
ds_act <- unique(Reduce("c",lapply(patient_need_states,function(x){rownames(x)})))
length(intersect(ds_act,rownames(activity_to_role)))==length(unique(rownames(activity_to_role)))
setdiff(ds_act,rownames(activity_to_role))
saveRDS(state_freq,"state_freq.rds")
saveRDS(state_switch_freq,"state_switch_freq.rds")
saveRDS(patient_need_states,"patient_need_states.rds")
